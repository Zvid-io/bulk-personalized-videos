# Copy to .env. Never commit real credentials.
# Create an API key at https://app.zvid.io/api-keys
ZVID_API_KEY=

# Optional API origin (default: https://api.zvid.io)
# ZVID_API_URL=https://api.zvid.io

# Optional callbacks in addition to this CLI's polling.
# ZVID_WEBHOOK_URL=https://example.com/hooks/zvid
