# Copy to .env and fill in. Never commit .env.
# Create an API key at https://app.zvid.io -> API Keys
ZVID_API_KEY=

# Optional: override the API origin (defaults to https://api.zvid.io)
# ZVID_API_URL=https://api.zvid.io

# Optional: receive a signed webhook per finished job (render.completed /
# render.failed) instead of relying on polling. See https://docs.zvid.io
# ZVID_WEBHOOK_URL=https://example.com/hooks/zvid
